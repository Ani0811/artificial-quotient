# Application Environment
NODE_ENV=development
PORT=3000

# Database Settings (Direct MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_strong_password
MYSQL_DATABASE=AQ-Dashboard

# Administrative Security & Master Keys
# In production, set strong unique random keys and change the default password
ADMIN_PASSWORD=your_super_strong_admin_password
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_MASTER_KEY=AQ-RESET-CHANGE-THIS-KEY
ADMIN_RECOVERY_KEYS=AQ-SEC-KEY1,AQ-SEC-KEY2

# Transactional Email (Brevo v3 API Multi-Key Pool)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=contact@yourdomain.com
CONTACT_RECEIVER_EMAIL=your_inbox@yourdomain.com

# SMTP Fallback Settings (Optional)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=contact@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_SECURE=true
SMTP_FROM="Artificial Quotient <contact@yourdomain.com>"

# YouTube Data API v3 (For live stats sync and video extraction)
YOUTUBE_API_KEY=your_youtube_api_v3_key_here
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# Firebase Configuration (Optional - for Google Auth / Analytics)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Production SEO & Verification
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_search_console_token
